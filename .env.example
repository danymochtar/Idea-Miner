# Vercel AI Gateway API key (Anthropic Messages API-compatible).
# Buat di: Vercel Dashboard → AI Gateway → API Keys
# Di Vercel: Project Settings → Environment Variables → tambahkan AI_GATEWAY_API_KEY
AI_GATEWAY_API_KEY=vck_...

# Opsional — hanya isi kalau mau override default:
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh
# AI_MODEL=anthropic/claude-opus-4.8
# Model khusus logo vektor (boleh model paling pintar biar desain lebih ciamik):
# AI_LOGO_MODEL=anthropic/claude-fable-5

# Logo Maker engine "Gambar" (Nano Banana) — pakai Google Gemini API key langsung.
# Dapatkan di: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsional: ganti model gambar (default gemini-2.5-flash-image / Nano Banana).
# Nano Banana 2: gemini-3.1-flash-image · Pro: gemini-3-pro-image
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
